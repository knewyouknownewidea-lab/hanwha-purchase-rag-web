{
  "name": "procure-ai-platform",
  "private": true,
  "version": "0.6.0",
  "description": "구매·협력사 AI 분석 DX 플랫폼 (시연용, SAMPLE 데이터)",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "build:hosting": "node hosting/build.mjs",
    "start": "node scripts/build.mjs && node server/index.mjs",
    "sample": "node scripts/generate-sample.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test:logic": "tsx tests/logic-smoke.ts && tsx tests/logic-v3.ts",
    "test:rag": "node scripts/check-rag-schema.mjs && node --test tests/rag-server.test.mjs && tsx tests/rag-client.test.ts",
    "test:hosting": "node --test hosting/handler.test.mjs hosting/artifact.test.mjs",
    "test:e2e:rag": "python tests/rag-e2e.py",
    "test:e2e": "python3 tests/e2e.py http://localhost:5173",
    "test:e2e:web-rag": "python tests/web-rag-e2e.py"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-icons": "5.7.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "0.28.2",
    "tsx": "4.23.12",
    "typescript": "6.0.3"
  }
}
